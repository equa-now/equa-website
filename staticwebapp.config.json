{
  "routes": [
    {
      "route": "/wemba",
      "redirect": "https://equa-test-app.azurewebsites.net/",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/advisors/*",
      "/logos/*",
      "/videos/*",
      "/favicon.ico",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpeg",
      "/*.jpg",
      "/*.ico",
      "/*.svg",
      "/*.webp",
      "/*.woff",
      "/*.woff2",
      "/*.mp4"
    ]
  }
}
